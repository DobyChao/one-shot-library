---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const title = '找不到这一页';
---

<Layout metadata={{ title }}>
  <section class="mx-auto flex max-w-xl flex-col items-start px-4 py-24 sm:px-6">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-primary">404</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-heading sm:text-5xl">没有这个页面</h1>
    <p class="mt-4 text-lg text-muted">地址可能写错了,或者这件作品还没有添加到画廊里。</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={getPermalink('/shots')} class="btn-primary">去画廊</a>
      <a href={getPermalink('/')} class="btn">回首页</a>
    </div>
  </section>
</Layout>
