---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const title = '找不到这一页';
---

<Layout metadata={{ title }}>
  <section class="mx-auto flex max-w-xl flex-col items-start px-4 py-24 sm:px-6">
    <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-primary">404 · Missing exhibit</p>
    <h1 class="mt-4 text-5xl font-semibold tracking-tight text-heading">这件不在馆里</h1>
    <p class="mt-4 text-lg text-muted">链接可能写错了,或者这件作品还没被收录。画廊里的其余展品都还在。</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={getPermalink('/shots')} class="btn-primary">去画廊</a>
      <a href={getPermalink('/')} class="btn">回首页</a>
    </div>
  </section>
</Layout>
