---
import Layout from '~/layouts/PageLayout.astro';
import ShotCard from '~/components/shots/ShotCard.astro';
import { Icon } from 'astro-icon/components';
import { fetchSeriesGroups } from '~/utils/shots';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const groups = await fetchSeriesGroups();

const metadata = {
  title: '同题对照',
  description: '把同一系列的作品并排放:各自的对话、工具、模型和预览。',
};

const promptsMatch = (shots: Array<{ prompt: string }>) =>
  shots.every((shot) => shot.prompt.trim() === shots[0]?.prompt.trim());
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <header class="mb-12 max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">Series</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-heading sm:text-5xl">同题对照</h1>
      <p class="mt-4 text-lg text-muted">
        给 frontmatter 写上同一个 <code class="font-mono text-sm">series</code> 的作品会收成一组。prompt 相同就共用一栏原文;不同就各自保留,方便看出命题差在哪里。
      </p>
    </header>

    {
      groups.length === 0 ? (
        <p class="border border-dashed border-black/15 px-6 py-16 text-center text-muted dark:border-white/15">
          还没有对照系列。在两件作品的 frontmatter 里写上相同的 <code class="font-mono text-sm">series</code> 即可。
        </p>
      ) : (
        <div class="space-y-16">
          {groups.map((group) => (
            <section aria-labelledby={`series-${group.slug}`}>
              <div class="mb-6 flex flex-wrap items-end justify-between gap-4 border-b border-black/10 pb-4 dark:border-white/10">
                <div>
                  <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                    {group.shots.length} 件 · {promptsMatch(group.shots) ? '同一条 prompt' : '各自的 prompt'}
                  </p>
                  <h2 id={`series-${group.slug}`} class="mt-1 text-2xl font-semibold text-heading">
                    {group.series}
                  </h2>
                </div>
                <a
                  href={getPermalink(`/shots/series/${group.slug}`)}
                  class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline"
                >
                  并排预览
                  <Icon name="tabler:arrows-split" class="h-4 w-4" aria-hidden="true" />
                </a>
              </div>
              <div class="grid gap-6 sm:grid-cols-2">
                {group.shots.map((shot, index) => (
                  <ShotCard shot={shot} index={index} />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </section>
</Layout>
