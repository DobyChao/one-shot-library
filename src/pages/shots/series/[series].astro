---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import PromptBox from '~/components/shots/PromptBox.astro';
import PreviewFrame from '~/components/shots/PreviewFrame.astro';
import MetaChips from '~/components/shots/MetaChips.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';

import { getStaticPathsSeries } from '~/utils/shots';
import { getAsset, getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsSeries();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { group } = Astro.props as Props;
const sharedPrompt = group.shots.every((shot) => shot.prompt.trim() === group.shots[0].prompt.trim())
  ? group.shots[0].prompt
  : undefined;

const metadata = {
  title: `同题对照 · ${group.series}`,
  description: sharedPrompt
    ? `系列「${group.series}」共用一条 prompt,并排查看 ${group.shots.length} 件产物。`
    : `系列「${group.series}」的 ${group.shots.length} 件产物,各自保留原始 prompt 与在线预览。`,
};

const breadcrumbs = [
  { text: '首页', href: getPermalink('/') },
  { text: '同题对照', href: getPermalink('/shots/series') },
  { text: group.series },
];

const liveOf = (shot: Props['group']['shots'][number]) => {
  const liveUrl = shot.html ? getAsset(`/artifacts/${shot.html}`) : shot.externalUrl;
  const isLocal = Boolean(shot.html);
  const downloadName = isLocal && shot.html && !shot.html.includes('/') ? shot.html : undefined;
  return { liveUrl, isLocal, downloadName };
};
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={breadcrumbs} />

  <article class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-8 max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">
        {group.shots.length} 件 · {sharedPrompt ? '同一条 prompt' : '各自的 prompt'}
      </p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-heading sm:text-5xl">{group.series}</h1>
      <p class="mt-4 text-lg text-muted">
        {
          sharedPrompt
            ? '这组作品用的是同一条 prompt。下面先放原文,再把预览并排摆开。'
            : '这组是同一命题下的多次生成,prompt 并不相同。每栏保留自己的原文,避免当成同一次输入。'
        }
      </p>
    </header>

    {sharedPrompt && <PromptBox prompt={sharedPrompt} id="prompt" />}

    <div class:list={['grid gap-10', group.shots.length > 1 && 'lg:grid-cols-2', sharedPrompt && 'mt-10']}>
      {
        group.shots.map((shot) => {
          const { liveUrl, isLocal, downloadName } = liveOf(shot);
          return (
            <section class="min-w-0" aria-labelledby={`shot-${shot.slug}`}>
              <MetaChips shot={shot} />
              <h2 id={`shot-${shot.slug}`} class="mt-3 text-2xl font-semibold tracking-tight text-heading">
                <a href={getPermalink(shot.permalink)} class="hover:text-primary">
                  {shot.title}
                </a>
              </h2>
              {shot.excerpt && <p class="mt-2 text-sm text-muted">{shot.excerpt}</p>}
              {!sharedPrompt && (
                <div class="mt-4">
                  <PromptBox prompt={shot.prompt} label={`${shot.title} 的 Prompt`} />
                </div>
              )}
              <div class="mt-4">
                {liveUrl ? (
                  <PreviewFrame
                    src={liveUrl}
                    title={shot.title}
                    isLocal={isLocal}
                    downloadName={downloadName}
                    heightClass="h-[64vh] min-h-[420px]"
                  />
                ) : (
                  <p class="border border-dashed border-black/15 px-4 py-10 text-center text-sm text-muted dark:border-white/15">
                    这件没有可嵌入的页面,只保留了 prompt 与截图。
                    <a href={getPermalink(shot.permalink)} class="mt-2 block font-medium text-primary hover:underline">
                      打开详情
                    </a>
                  </p>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    <p class="mt-12">
      <a
        href={getPermalink('/shots/series')}
        class="inline-flex items-center gap-2 font-medium text-primary hover:underline"
      >
        <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
        全部对照系列
      </a>
    </p>
  </article>
</Layout>
