---
import Layout from '~/layouts/PageLayout.astro';
import ShotCard from '~/components/shots/ShotCard.astro';
import { fetchShots } from '~/utils/shots';

export const prerender = true;

const shots = await fetchShots();

const countBy = (values: Array<string | undefined>) => {
  const counts = new Map<string, number>();
  for (const value of values) {
    if (!value) continue;
    counts.set(value, (counts.get(value) ?? 0) + 1);
  }
  return [...counts.entries()]
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'))
    .map(([value, count]) => ({
      value,
      count,
    }));
};

const contentTags = countBy(shots.flatMap((shot) => (shot.tags ?? []).map((tag) => tag.title)));
const models = countBy(shots.map((shot) => shot.model));
const harnesses = countBy(shots.map((shot) => shot.harness));
const turns = countBy(shots.map((shot) => String(shot.turns ?? 1))).map((item) => ({
  ...item,
  label: `${item.value} 轮`,
}));
const modes = countBy(shots.map((shot) => shot.mode)).map((item) => ({
  ...item,
  label: item.value === 'vibe' ? '多轮 · vibe' : '一轮 · one-shot',
}));

const oneShotCount = shots.filter((shot) => shot.mode === 'one-shot').length;
const vibeCount = shots.filter((shot) => shot.mode === 'vibe').length;

const filterGroups = [
  { label: '方式', en: 'Mode', key: 'mode', values: modes },
  { label: '类型', en: 'Type', key: 'type', values: contentTags.map((item) => ({ ...item, label: item.value })) },
  { label: '模型', en: 'Model', key: 'model', values: models.map((item) => ({ ...item, label: item.value })) },
  { label: '工具', en: 'Harness', key: 'harness', values: harnesses.map((item) => ({ ...item, label: item.value })) },
  { label: '轮数', en: 'Turns', key: 'turns', values: turns },
].filter((group) => group.values.length > 0);

const chipGroups = filterGroups.filter((group) => group.values.length > 1);
const singletonGroups = filterGroups.filter((group) => group.values.length === 1);

const metadata = {
  title: '画廊',
  description: 'vibecoding 产物画廊。可以按方式、类型、模型、工具和轮数筛选,也可以搜标题和对话。',
};

const chipBase =
  'rounded-md px-3 py-1.5 text-sm font-medium transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const chipActive = `${chipBase} bg-button text-white hover:bg-button-hover`;
const chipInactive = `${chipBase} bg-black/5 text-default hover:bg-black/10 dark:bg-white/10 dark:hover:bg-white/15`;

const searchText = (shot: (typeof shots)[number]) =>
  [
    shot.title,
    shot.excerpt,
    shot.vibe,
    shot.outcome,
    shot.prompt,
    ...shot.session.flatMap((turn) => [turn.text, turn.note]),
    shot.model,
    shot.harness,
    shot.series,
    ...(shot.tags ?? []).map((tag) => tag.title),
  ]
    .filter(Boolean)
    .join(' ')
    .replace(/\s+/g, ' ')
    .trim();
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <header class="mb-10 max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">Gallery</p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-heading sm:text-5xl">作品画廊</h1>
      <p class="mt-4 text-lg text-muted">
        一共 {shots.length} 件作品。其中 {oneShotCount} 件只对话了一轮,{vibeCount} 件来回改过。点进去可以看当时的对话和最后的
        HTML。
      </p>
    </header>

    {
      shots.length === 0 ? (
        <p class="border border-dashed border-black/15 px-6 py-16 text-center text-muted dark:border-white/15">
          还没有作品。往 <code class="font-mono text-sm">src/data/shot/</code> 里加一个 markdown 文件试试。
        </p>
      ) : (
        <div id="shots-browser">
          <div class="mb-8 space-y-5 rounded-md border border-black/10 p-4 sm:p-5 dark:border-white/10">
            <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
              <div class="min-w-0 flex-1">
                <label
                  for="shots-query"
                  class="mb-2 block font-mono text-[11px] uppercase tracking-[0.16em] text-muted"
                >
                  搜索 · Search
                </label>
                <input
                  id="shots-query"
                  type="search"
                  placeholder="标题、摘要、对话、模型"
                  autocomplete="off"
                  class="w-full rounded-md border border-black/10 bg-page px-3 py-2 text-sm text-default placeholder:text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/15"
                />
              </div>
              <div>
                <p id="group-label" class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                  分组 · Group
                </p>
                <div role="radiogroup" aria-labelledby="group-label" class="flex flex-wrap gap-2">
                  {[
                    ['flat', '平铺'],
                    ['mode', '按方式'],
                    ['harness', '按工具'],
                    ['model', '按模型'],
                  ].map(([mode, label], index) => (
                    <button
                      type="button"
                      role="radio"
                      data-group-mode={mode}
                      aria-checked={index === 0 ? 'true' : 'false'}
                      tabindex={index === 0 ? 0 : -1}
                      class={index === 0 ? chipActive : chipInactive}
                    >
                      {label}
                    </button>
                  ))}
                </div>
              </div>
            </div>

            {chipGroups.map((group) => (
              <fieldset class="min-w-0 border-0 p-0">
                <legend class="mb-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
                  {group.label} · {group.en}
                </legend>
                <div role="radiogroup" aria-label={`按${group.label}筛选`} class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    role="radio"
                    data-filter-group={group.key}
                    data-filter-value="*"
                    aria-checked="true"
                    tabindex="0"
                    class={chipActive}
                  >
                    全部
                  </button>
                  {group.values.map(({ value, count, label }) => (
                    <button
                      type="button"
                      role="radio"
                      data-filter-group={group.key}
                      data-filter-value={value}
                      aria-checked="false"
                      tabindex="-1"
                      class={chipInactive}
                    >
                      {label}
                      <span class="ml-1 font-mono text-[11px] opacity-80">{count}</span>
                    </button>
                  ))}
                </div>
              </fieldset>
            ))}

            {singletonGroups.length > 0 && (
              <p class="text-sm text-muted">
                {singletonGroups
                  .map(
                    (group) =>
                      `${group.label}这一项里,标出来的只有 ${group.values[0].label}（${group.values[0].count}）`
                  )
                  .join('；')}
                。
              </p>
            )}

            <div class="flex flex-wrap items-center justify-between gap-3 border-t border-black/10 pt-3 dark:border-white/10">
              <p id="shots-status" aria-live="polite" aria-atomic="true" class="text-sm text-muted">
                显示全部 {shots.length} 件
              </p>
              <button type="button" data-filter-reset class="hidden text-sm font-medium text-primary hover:underline">
                重置筛选
              </button>
            </div>
          </div>

          <div id="shots-grid" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {shots.map((shot, index) => (
              <div
                data-shot-item
                data-shot-index={index}
                data-shot-tags={(shot.tags ?? []).map((tag) => tag.title).join('|')}
                data-shot-mode={shot.mode}
                data-shot-model={shot.model ?? ''}
                data-shot-harness={shot.harness ?? ''}
                data-shot-turns={String(shot.turns ?? 1)}
                data-shot-series={shot.series ?? ''}
                data-shot-search={searchText(shot)}
                class="flex"
              >
                <ShotCard shot={shot} index={index} />
              </div>
            ))}
          </div>

          <p
            id="shots-empty"
            class="hidden border border-dashed border-black/15 px-6 py-16 text-center text-muted dark:border-white/15"
          >
            没有符合条件的作品。重置筛选,或换个关键词。
          </p>
        </div>
      )
    }
  </section>
</Layout>

<script>
  // Filters are AND-combined across groups and single-select inside a group.
  // Grouping only rearranges the same cards. No-JS visitors still get the full grid.
  //
  // Listeners live on `document` and re-query the DOM on `astro:page-load`, because
  // the ClientRouter swaps the page and skips identical inline scripts on revisits.
  const state: Record<string, string> = {
    type: '*',
    mode: '*',
    model: '*',
    harness: '*',
    turns: '*',
    group: 'flat',
    query: '',
  };
  const groupModes = ['flat', 'mode', 'harness', 'model'];
  const activeClasses = ['bg-button', 'text-white', 'hover:bg-button-hover'];
  const inactiveClasses = [
    'bg-black/5',
    'text-default',
    'hover:bg-black/10',
    'dark:bg-white/10',
    'dark:hover:bg-white/15',
  ];

  const currentRoot = () => document.querySelector<HTMLElement>('#shots-browser');

  const readParams = () => {
    const params = new URLSearchParams(window.location.search);
    return {
      type: params.get('type') || '*',
      mode: params.get('mode') || '*',
      model: params.get('model') || '*',
      harness: params.get('harness') || '*',
      turns: params.get('turns') || '*',
      group: params.get('group') || 'flat',
      query: params.get('q') || '',
    };
  };

  const writeParams = () => {
    const url = new URL(window.location.href);
    const entries = [
      ['type', state.type],
      ['mode', state.mode],
      ['model', state.model],
      ['harness', state.harness],
      ['turns', state.turns],
      ['group', state.group === 'flat' ? '' : state.group],
      ['q', state.query],
    ];
    for (const [key, value] of entries) {
      if (!value || value === '*') url.searchParams.delete(key);
      else url.searchParams.set(key, value);
    }
    window.history.replaceState(null, '', url);
  };

  const apply = () => {
    const root = currentRoot();
    if (!root) return;
    const grid = root.querySelector('#shots-grid');
    const empty = root.querySelector('#shots-empty');
    const status = root.querySelector('#shots-status');
    const reset = root.querySelector('[data-filter-reset]');
    const items = [...root.querySelectorAll<HTMLElement>('[data-shot-item]')];
    if (!grid) return;

    root.querySelectorAll<HTMLElement>('[role="radio"]').forEach((btn) => {
      const filterGroup = btn.dataset.filterGroup;
      const mode = btn.dataset.groupMode;
      const isActive = filterGroup ? state[filterGroup] === btn.dataset.filterValue : state.group === mode;
      btn.setAttribute('aria-checked', String(isActive));
      btn.tabIndex = isActive ? 0 : -1;
      btn.classList.remove(...activeClasses, ...inactiveClasses);
      btn.classList.add(...(isActive ? activeClasses : inactiveClasses));
    });

    const query = state.query.toLowerCase();
    const visible = [];
    items.forEach((item) => {
      const tags = (item.dataset.shotTags || '').split('|').filter(Boolean);
      const haystack = (item.dataset.shotSearch || '').toLowerCase();
      const ok =
        (state.type === '*' || tags.includes(state.type)) &&
        (state.mode === '*' || item.dataset.shotMode === state.mode) &&
        (state.model === '*' || item.dataset.shotModel === state.model) &&
        (state.harness === '*' || item.dataset.shotHarness === state.harness) &&
        (state.turns === '*' || item.dataset.shotTurns === state.turns) &&
        (!query || haystack.includes(query));
      item.classList.toggle('hidden', !ok);
      if (ok) visible.push(item);
    });

    grid.querySelectorAll('[data-group-heading]').forEach((heading) => heading.remove());
    const ordered = [...items].sort((a, b) => Number(a.dataset.shotIndex) - Number(b.dataset.shotIndex));

    if (state.group === 'flat') {
      ordered.forEach((item) => grid.appendChild(item));
    } else {
      const key = state.group === 'harness' ? 'shotHarness' : state.group === 'model' ? 'shotModel' : 'shotMode';
      const groups = new Map<string, HTMLElement[]>();
      for (const item of ordered) {
        const raw = item.dataset[key] || '';
        const label =
          state.group === 'mode' && raw === 'vibe'
            ? '多轮 · vibe'
            : state.group === 'mode' && raw === 'one-shot'
              ? '一轮 · one-shot'
              : raw || '未标注';
        const list = groups.get(label) || [];
        list.push(item);
        groups.set(label, list);
      }
      const entries = [...groups.entries()].sort((a, b) => {
        const shown = (list: HTMLElement[]) => list.filter((item) => !item.classList.contains('hidden')).length;
        const delta = shown(b[1]) - shown(a[1]);
        if (delta !== 0) return delta;
        if (a[0] === '未标注') return 1;
        if (b[0] === '未标注') return -1;
        return a[0].localeCompare(b[0], 'zh');
      });
      for (const [label, groupItems] of entries) {
        const shown = groupItems.filter((item) => !item.classList.contains('hidden'));
        if (shown.length === 0) {
          groupItems.forEach((item) => grid.appendChild(item));
          continue;
        }
        const heading = document.createElement('h2');
        heading.dataset.groupHeading = 'true';
        heading.className =
          'col-span-full mt-2 flex items-baseline gap-3 border-b border-black/10 pb-2 dark:border-white/10';
        const name = document.createElement('span');
        name.className = 'text-lg font-semibold text-heading';
        name.textContent = label;
        const count = document.createElement('span');
        count.className = 'font-mono text-xs text-muted';
        count.textContent = `${shown.length} 件`;
        heading.append(name, count);
        grid.appendChild(heading);
        groupItems.forEach((item) => grid.appendChild(item));
      }
    }

    empty?.classList.toggle('hidden', visible.length > 0);
    if (status) {
      status.textContent =
        visible.length === items.length ? `显示全部 ${items.length} 件` : `显示 ${visible.length} / ${items.length} 件`;
    }
    const filtering =
      state.type !== '*' ||
      state.mode !== '*' ||
      state.model !== '*' ||
      state.harness !== '*' ||
      state.turns !== '*' ||
      state.query !== '';
    reset?.classList.toggle('hidden', !filtering);
  };

  const hydrate = () => {
    if (!currentRoot()) return;
    const next = readParams();
    state.type = next.type;
    state.mode = next.mode;
    state.model = next.model;
    state.harness = next.harness;
    state.turns = next.turns;
    state.group = groupModes.includes(next.group) ? next.group : 'flat';
    state.query = next.query;
    const input = currentRoot()?.querySelector<HTMLInputElement>('#shots-query');
    if (input && document.activeElement !== input) input.value = state.query;
    apply();
  };

  const onClick = (event: MouseEvent) => {
    const root = currentRoot();
    const target = event.target;
    if (!root || !(target instanceof Element) || !root.contains(target)) return;
    const filterBtn = target.closest<HTMLElement>('[data-filter-group]');
    const groupBtn = target.closest<HTMLElement>('[data-group-mode]');
    const reset = target.closest('[data-filter-reset]');
    if (filterBtn) state[filterBtn.dataset.filterGroup || 'type'] = filterBtn.dataset.filterValue || '*';
    else if (groupBtn) state.group = groupBtn.dataset.groupMode || 'flat';
    else if (reset) {
      state.type = '*';
      state.mode = '*';
      state.model = '*';
      state.harness = '*';
      state.turns = '*';
      state.query = '';
      const input = root.querySelector<HTMLInputElement>('#shots-query');
      if (input) input.value = '';
    } else return;
    apply();
    writeParams();
  };

  const onInput = (event: Event) => {
    const root = currentRoot();
    const target = event.target;
    if (!root || !(target instanceof HTMLInputElement) || target.id !== 'shots-query' || !root.contains(target)) return;
    state.query = target.value.trim();
    apply();
    writeParams();
  };

  const onKeyDown = (event: KeyboardEvent) => {
    const root = currentRoot();
    const target = event.target;
    if (!root || !(target instanceof Element) || !root.contains(target)) return;
    if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
    const radio = target.closest<HTMLElement>('[role="radio"]');
    const group = radio?.closest('[role="radiogroup"]');
    if (!radio || !group) return;
    const radios = [...group.querySelectorAll<HTMLElement>('[role="radio"]')];
    const index = radios.indexOf(radio);
    if (index < 0) return;
    const next =
      event.key === 'ArrowRight' || event.key === 'ArrowDown'
        ? (index + 1) % radios.length
        : event.key === 'ArrowLeft' || event.key === 'ArrowUp'
          ? (index - 1 + radios.length) % radios.length
          : event.key === 'Home'
            ? 0
            : radios.length - 1;
    event.preventDefault();
    radios[next].focus();
    radios[next].click();
  };

  if (!document.documentElement.dataset.oslGallery) {
    document.documentElement.dataset.oslGallery = '1';
    document.addEventListener('click', onClick);
    document.addEventListener('input', onInput);
    document.addEventListener('keydown', onKeyDown);
  }

  document.addEventListener('astro:page-load', hydrate);
  hydrate();
</script>
