---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import PreviewFrame from '~/components/shots/PreviewFrame.astro';
import SessionTimeline from '~/components/shots/SessionTimeline.astro';
import MetaChips from '~/components/shots/MetaChips.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import type { ImageMetadata } from 'astro';

import { fetchShots, getStaticPathsShots, shotModeLabel } from '~/utils/shots';
import { findImage } from '~/utils/images';
import { getAsset, getPermalink } from '~/utils/permalinks';
import { truncateAtWord } from '~/utils/utils';

export const prerender = true;

export const getStaticPaths = (async () => {
  return await getStaticPathsShots();
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { shot } = Astro.props as Props;

const image = (await findImage(shot.image)) as ImageMetadata | string | undefined;
// Artifacts live in public/artifacts/ so their URLs (/artifacts/<file>.html) can
// never collide with these detail routes under /shots/.
const liveUrl = shot.html ? getAsset(`/artifacts/${shot.html}`) : shot.externalUrl;
const isLocalFile = Boolean(shot.html);
// 下载按钮只对单文件产物有意义;多文件(子目录)产物只下一个 index.html 是残缺的。
const downloadName = isLocalFile && shot.html && !shot.html.includes('/') ? shot.html : undefined;

const metadata = {
  title: shot.title,
  description: truncateAtWord(shot.excerpt, 155),
  openGraph: {
    ...(image ? { images: [{ url: image as unknown as string, width: 1440, height: 900 }] } : {}),
  },
};

const breadcrumbs = [
  { text: '首页', href: getPermalink('/') },
  { text: '画廊', href: getPermalink('/shots') },
  { text: shot.title },
];

const formatDate = (date: Date) => date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const infoCells: Array<{ label: string; value: string; hint?: string; icon: string }> = [
  {
    label: '方式 · Mode',
    value: shotModeLabel(shot.mode),
    hint: shot.mode === 'vibe' ? '中间改过' : '只发过一次',
    icon: shot.mode === 'vibe' ? 'tabler:messages' : 'tabler:bolt',
  },
];
if (shot.harness) {
  infoCells.push({ label: '工具 · Harness', value: shot.harness, hint: '驱动这次生成的工具', icon: 'tabler:robot' });
}
if (shot.model) {
  infoCells.push({ label: '模型 · Model', value: shot.model, hint: '实际调用的模型', icon: 'tabler:cpu' });
}
infoCells.push({
  label: '轮数 · Turns',
  value: `${shot.turns} 轮`,
  hint: '算用户发了几次',
  icon: 'tabler:messages',
});
infoCells.push({ label: '日期 · Date', value: formatDate(shot.publishDate), icon: 'tabler:calendar' });
if (shot.updateDate) {
  infoCells.push({ label: '更新 · Updated', value: formatDate(shot.updateDate), icon: 'tabler:refresh' });
}
infoCells.push({
  label: '形式 · File',
  value: isLocalFile ? '本站托管 HTML' : shot.externalUrl ? '外部链接' : '仅截图存档',
  hint: isLocalFile ? '静态文件,沙箱内预览' : undefined,
  icon: 'tabler:file-code',
});

const allShots = await fetchShots();
const currentIndex = allShots.findIndex((item) => item.slug === shot.slug);
const newerShot = currentIndex > 0 ? allShots[currentIndex - 1] : undefined;
const olderShot = currentIndex >= 0 && currentIndex < allShots.length - 1 ? allShots[currentIndex + 1] : undefined;

const metricsGlob = import.meta.glob<{
  performance: number;
  accessibility: number;
  bestPractices: number;
  seo: number;
}>('~/data/shot-metrics/*.json', { eager: true });
const metrics = metricsGlob[`/src/data/shot-metrics/${shot.slug}.json`];
const scoreColor = (score: number) =>
  score >= 90
    ? 'text-emerald-700 dark:text-emerald-300'
    : score >= 50
      ? 'text-amber-700 dark:text-amber-300'
      : 'text-red-600 dark:text-red-400';

const jumpClass =
  'inline-flex items-center gap-1.5 rounded-md border border-black/10 px-3 py-1.5 text-sm font-medium text-default hover:bg-black/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary dark:border-white/15 dark:hover:bg-white/10';
---

<Layout metadata={metadata}>
  <Breadcrumbs bar items={breadcrumbs} />

  <article class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="mb-8">
      <MetaChips shot={shot} />

      <h1 class="mt-4 max-w-4xl text-4xl font-semibold tracking-tight text-heading sm:text-5xl">{shot.title}</h1>

      {shot.excerpt && <p class="mt-4 max-w-3xl text-lg text-muted">{shot.excerpt}</p>}

      <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
        <span class="inline-flex items-center gap-1.5">
          <Icon name="tabler:calendar" class="h-4 w-4" aria-hidden="true" />
          {formatDate(shot.publishDate)}
        </span>
        {
          (shot.tags ?? []).map((tag) => (
            <span class="rounded bg-black/5 px-2 py-0.5 text-xs dark:bg-white/10">{tag.title}</span>
          ))
        }
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        <a href="#session" class={jumpClass}>
          <Icon name="tabler:message-chatbot" class="h-4 w-4" aria-hidden="true" />
          看对话
        </a>
        <a href="#live-preview" class={jumpClass}>
          <Icon name="tabler:app-window" class="h-4 w-4" aria-hidden="true" />
          看页面
        </a>
      </div>
    </header>

    {
      (shot.vibe || shot.outcome) && (
        <aside class="mb-10 max-w-3xl border-l-2 border-button pl-5">
          {shot.vibe && (
            <>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">想要的效果</p>
              <p class="mt-2 text-lg leading-snug text-heading">{shot.vibe}</p>
            </>
          )}
          {shot.outcome && (
            <p class="mt-3 text-muted">
              <span class="font-medium text-heading">改完之后 · </span>
              {shot.outcome}
            </p>
          )}
        </aside>
      )
    }

    <section id="session" class="mb-12 scroll-mt-24" aria-labelledby="session-heading">
      <div class="mb-4 max-w-3xl">
        <h2 id="session-heading" class="text-xl font-semibold text-heading">会话</h2>
        <p class="mt-1 text-sm text-muted">
          {
            shot.mode === 'one-shot'
              ? '只发过一次。下面是当时那条 prompt,页面在更下面。'
              : '按当时的顺序排。用户发一次算一轮。某一步如果存了中间页面,点开就能看。'
          }
        </p>
      </div>
      <SessionTimeline session={shot.session} finalHtml={shot.html} title={shot.title} />
    </section>

    <section class="mb-12" aria-labelledby="info-heading">
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="info-heading" class="text-xl font-semibold text-heading">生成信息</h2>
        <p class="text-xs text-muted">收录时填的,不会自动更新。</p>
      </div>
      <dl
        class="grid grid-cols-1 gap-px overflow-hidden rounded-md border border-black/10 bg-black/10 sm:grid-cols-2 dark:border-white/10 dark:bg-white/10"
      >
        {
          infoCells.map((cell) => (
            <div class="bg-page p-4">
              <dt class="flex items-center gap-2 text-xs uppercase tracking-wider text-muted">
                <Icon name={cell.icon} class="h-4 w-4 text-primary" aria-hidden="true" />
                {cell.label}
              </dt>
              <dd class="mt-1 text-sm font-semibold text-heading">{cell.value}</dd>
              {cell.hint && <dd class="mt-1 text-xs text-muted">{cell.hint}</dd>}
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mb-12 scroll-mt-24" id="live-preview" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="mb-4 flex items-center gap-2 text-xl font-semibold text-heading">
        <Icon name="tabler:app-window" class="h-5 w-5 text-primary" aria-hidden="true" />
        页面预览
      </h2>
      {
        liveUrl ? (
          <PreviewFrame src={liveUrl} title={shot.title} isLocal={isLocalFile} downloadName={downloadName} />
        ) : (
          <p class="border border-dashed border-black/15 px-6 py-16 text-center text-muted dark:border-white/15">
            这件作品没有可嵌入的页面,只保留了截图和 prompt。
          </p>
        )
      }
    </section>

    {
      image && (
        <figure class="mb-12">
          <div class="overflow-hidden rounded-md border border-black/10 dark:border-white/10">
            <img
              src={typeof image === 'string' ? image : image.src}
              alt={shot.imageAlt || shot.title}
              class="w-full"
              width={1440}
              height={900}
              loading="lazy"
            />
          </div>
          <figcaption class="mt-2 text-center text-sm text-muted">生成结果首屏截图</figcaption>
        </figure>
      )
    }

    {
      metrics && (
        <section class="mb-12" aria-labelledby="lighthouse-heading">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="lighthouse-heading" class="flex items-center gap-2 text-xl font-semibold text-heading">
              <Icon name="tabler:gauge" class="h-5 w-5 text-primary" aria-hidden="true" />
              Lighthouse 跑分
            </h2>
            <p class="text-xs text-muted">收录时对产物页面的一次实测,不会自动更新。</p>
          </div>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
            {(
              [
                ['性能', metrics.performance],
                ['无障碍', metrics.accessibility],
                ['最佳实践', metrics.bestPractices],
                ['SEO', metrics.seo],
              ] as const
            ).map(([label, score]) => (
              <div class="rounded-md border border-black/10 bg-page p-4 text-center dark:border-white/10">
                <p class={`font-mono text-3xl font-semibold ${scoreColor(score)}`}>{score}</p>
                <p class="mt-1 text-xs uppercase tracking-wider text-muted">{label}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      shot.Content && (
        <section class="mb-12">
          <h2 class="mb-4 flex items-center gap-2 text-xl font-semibold text-heading">
            <Icon name="tabler:notes" class="h-5 w-5 text-primary" aria-hidden="true" />
            备注
          </h2>
          <div class="prose prose-lg max-w-none dark:prose-invert prose-a:text-primary">
            <shot.Content />
          </div>
        </section>
      )
    }

    <nav class="mt-16 border-t border-black/10 pt-8 dark:border-white/10" aria-label="更多作品">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <a
          href={getPermalink('/shots')}
          class="inline-flex items-center gap-2 font-medium text-primary hover:underline"
        >
          <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
          返回画廊
        </a>

        <div class="flex items-center gap-6">
          {
            olderShot && (
              <a
                href={getPermalink(olderShot.permalink)}
                class="inline-flex max-w-[220px] items-center gap-2 text-sm text-muted hover:text-primary"
              >
                <Icon name="tabler:arrow-left" class="h-4 w-4 shrink-0" aria-hidden="true" />
                <span class="min-w-0">
                  <span class="block text-[11px] uppercase tracking-wider">上一件</span>
                  <span class="block truncate font-medium text-heading">{olderShot.title}</span>
                </span>
              </a>
            )
          }
          {
            newerShot && (
              <a
                href={getPermalink(newerShot.permalink)}
                class="inline-flex max-w-[220px] items-center justify-end gap-2 text-right text-sm text-muted hover:text-primary"
              >
                <span class="min-w-0">
                  <span class="block text-[11px] uppercase tracking-wider">下一件</span>
                  <span class="block truncate font-medium text-heading">{newerShot.title}</span>
                </span>
                <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
              </a>
            )
          }
        </div>
      </div>
    </nav>
  </article>
</Layout>
