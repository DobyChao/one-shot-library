---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ShotCard from '~/components/shots/ShotCard.astro';
import { Icon } from 'astro-icon/components';
import { I18N, METADATA, SITE } from 'astrowind:config';

import { fetchSeriesGroups, fetchShots, findLatestShots } from '~/utils/shots';
import { getHomePermalink, getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'One-Shot Library — AI 做的前端小页面',
  ignoreTitleTemplate: true,
};

const [latestShots, allShots, seriesGroups] = await Promise.all([
  findLatestShots({ count: 6 }),
  fetchShots(),
  fetchSeriesGroups(),
]);

const oneShotCount = allShots.filter((shot) => shot.mode === 'one-shot').length;
const vibeCount = allShots.filter((shot) => shot.mode === 'vibe').length;
const harnessCount = new Set(allShots.map((shot) => shot.harness).filter(Boolean)).size;
const featured = seriesGroups[0];
const featuredPromptsMatch = featured
  ? featured.shots.every((shot) => shot.prompt.trim() === featured.shots[0].prompt.trim())
  : false;

const homeUrl = SITE.site ? new URL(getHomePermalink(), SITE.site).href : getHomePermalink();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE?.name,
  url: homeUrl,
  description: METADATA?.description,
  inLanguage: I18N?.language,
  publisher: {
    '@type': 'Organization',
    name: SITE?.name,
    url: homeUrl,
  },
};

const stats = [
  { value: String(allShots.length), label: '件作品', en: 'Shots' },
  { value: String(oneShotCount), label: '只改一轮', en: 'One-shot' },
  { value: String(vibeCount), label: '改过几轮', en: 'Vibe' },
  { value: String(harnessCount), label: '种工具', en: 'Harness' },
  { value: String(seriesGroups.length), label: '组对照', en: 'Series' },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <section class="osl-grid border-b border-black/10 dark:border-white/10">
    <div class="mx-auto max-w-7xl px-4 pb-12 pt-14 sm:px-6 lg:px-8 lg:pb-16 lg:pt-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-primary">One-Shot Library · 静态站点</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight text-heading sm:text-5xl">
        AI 做的页面,放在这里看
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        落地页、仪表盘、小工具。每件旁边放着当时的 prompt、用过的工具和模型、改了几轮,以及能打开的
        HTML。只改过一轮的和来回改过的都收在这里。文件是静态的,不打分,也不投票。
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={getPermalink('/shots')} class="btn-primary w-full sm:w-auto">
          进入画廊
          <Icon name="tabler:arrow-right" class="ml-1.5 h-5 w-5" aria-hidden="true" />
        </a>
        <a href={`${getPermalink('/about')}#submit`} class="btn w-full sm:w-auto">提交作品</a>
      </div>
    </div>

    <dl
      class="mx-auto grid max-w-7xl grid-cols-2 gap-px overflow-hidden border-t border-black/10 bg-black/10 sm:grid-cols-3 lg:grid-cols-5 dark:border-white/10 dark:bg-white/10"
    >
      {
        stats.map((stat) => (
          <div class="bg-page px-4 py-5 sm:px-6 lg:px-8">
            <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted">{stat.en}</dt>
            <dd class="mt-1 font-mono text-3xl font-semibold tracking-tight text-heading">{stat.value}</dd>
            <dd class="text-sm text-muted">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    featured && (
      <section class="border-b border-black/10 dark:border-white/10" aria-labelledby="series-heading">
        <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
          <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
            <div class="max-w-2xl">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">Side by side</p>
              <h2 id="series-heading" class="mt-2 text-3xl font-semibold tracking-tight text-heading">
                同题对照
              </h2>
              <p class="mt-3 text-muted">
                系列「{featured.series}」把题目接近的作品放在一起。
                {featuredPromptsMatch
                  ? '这组共用同一条 prompt,并排就能看出一次生成的差别。'
                  : 'prompt 并不完全相同,对照页会把各自的原文和预览摆在一起。'}
              </p>
            </div>
            <a
              href={getPermalink(`/shots/series/${featured.slug}`)}
              class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline"
            >
              并排预览
              <Icon name="tabler:arrows-split" class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
          <div class="grid gap-6 lg:grid-cols-2">
            {featured.shots.map((shot, index) => (
              <ShotCard shot={shot} index={index} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 lg:py-16" aria-labelledby="latest-heading">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-primary">Latest shots</p>
        <h2 id="latest-heading" class="mt-2 text-3xl font-semibold tracking-tight text-heading">最近放上来的</h2>
      </div>
      <a
        href={getPermalink('/shots')}
        class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline"
      >
        查看全部 {allShots.length} 件
        <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
    {
      latestShots.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {latestShots.map((shot, index) => (
            <ShotCard shot={shot} index={index} />
          ))}
        </div>
      ) : (
        <p class="border border-dashed border-black/15 px-6 py-16 text-center text-muted dark:border-white/15">
          还没有作品。往 <code class="font-mono text-sm">src/data/shot/</code> 里加一个 markdown 文件即可。
        </p>
      )
    }
  </section>

  <section class="border-t border-black/10 dark:border-white/10" aria-labelledby="read-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <h2 id="read-heading" class="text-3xl font-semibold tracking-tight text-heading">详情页里有什么</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-muted">
        改过几轮的作品,标题下面有一句当时想要的效果,卡片上也先显示这句。接着是按时间排的对话,每一轮都能复制。只改一轮的,对话里就那条
        prompt。再往下是收录时填的工具、模型和轮数,最后是沙箱里的页面,可以改成手机宽度,也可以新窗口打开。中间如果留了稿,挂在对应那一轮下面。
      </p>
    </div>
  </section>

  <section class="border-t border-black/10 dark:border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:px-8"
    >
      <div class="max-w-xl">
        <h2 class="text-3xl font-semibold tracking-tight text-heading">要加一件</h2>
        <p class="mt-3 text-muted">
          现在有 {allShots.length} 件。{oneShotCount} 件只改了一轮,{vibeCount} 件改过几轮。把 prompt、对话和 HTML 交过来就行。
        </p>
      </div>
      <a href={`${getPermalink('/about')}#submit`} class="btn-primary w-full shrink-0 sm:w-auto">
        了解如何提交
        <Icon name="tabler:upload" class="ml-1.5 h-5 w-5" aria-hidden="true" />
      </a>
    </div>
  </section>
</Layout>
