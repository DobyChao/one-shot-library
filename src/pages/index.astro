---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ShotCard from '~/components/shots/ShotCard.astro';
import { Icon } from 'astro-icon/components';

import { findLatestShots, fetchShots } from '~/utils/shots';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'One-Shot Library — 一个 Prompt,一个页面',
  ignoreTitleTemplate: true,
};

const [latestShots, allShots] = await Promise.all([findLatestShots({ count: 6 }), fetchShots()]);
const oneShotCount = allShots.filter((s) => (s.turns ?? 1) === 1).length;
---

<Layout metadata={metadata}>
  <Hero
    tagline="AI one-shot 前端产物画廊"
    actions={[
      { variant: 'primary', text: '浏览画廊', href: getPermalink('/shots'), icon: 'tabler:layout-grid' },
      { text: '提交作品', href: getPermalink('/about#submit') },
    ]}
  >
    <Fragment slot="title">
      一个 Prompt,<br class="hidden sm:block" />
      <span class="text-accent dark:text-white">一个页面</span>
    </Fragment>

    <Fragment slot="subtitle">
      这里收藏 AI 在<strong>一条 prompt 内</strong>直接生成的前端作品:落地页、仪表盘、小工具。 每件作品都附原始
      prompt、使用的模型和可交互的在线预览——所见即所得,没有返工。
    </Fragment>
  </Hero>

  <section class="px-4 py-16 sm:px-6 mx-auto max-w-6xl lg:px-8">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-primary">Latest Shots</p>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white sm:text-3xl">最新作品</h2>
      </div>
      <a
        href={getPermalink('/shots')}
        class="inline-flex items-center gap-1.5 font-medium text-primary hover:underline dark:text-blue-400"
      >
        查看全部 ({allShots.length})
        <Icon name="tabler:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {latestShots.map((shot) => <ShotCard shot={shot} />)}
    </div>
  </section>

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '了解如何提交',
        href: `${getPermalink('/about')}#submit`,
        icon: 'tabler:upload',
      },
    ]}
  >
    <Fragment slot="title">下一个 one-shot 就在你手里</Fragment>
    <Fragment slot="subtitle">
      已收录 {allShots.length} 件作品,其中 {oneShotCount} 件是真正的 zero-touch one-shot。<br
        class="hidden md:inline"
      />
      把你最好的那条 prompt 和产物交出来,让它们被看见。
    </Fragment>
  </CallToAction>
</Layout>
