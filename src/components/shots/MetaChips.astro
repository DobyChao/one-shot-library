---
import { Icon } from 'astro-icon/components';
import type { Shot } from '~/types';

interface Props {
  shot: Pick<Shot, 'harness' | 'model' | 'turns' | 'mode'>;
  compact?: boolean;
}

const { shot, compact = false } = Astro.props;
const pad = compact ? 'px-2 py-0.5 text-[11px]' : 'px-2.5 py-1 text-xs';
const icon = compact ? 'h-3 w-3' : 'h-3.5 w-3.5';
const turns = shot.turns ?? 1;
const vibeLabel = turns === 1 ? 'vibe · 1 轮' : `vibe · ${turns} 轮`;
---

<div class="flex flex-wrap items-center gap-1.5">
  {
    shot.harness && (
      <span class:list={['inline-flex items-center gap-1 rounded-full bg-accent/10 font-medium text-accent', pad]}>
        <Icon name="tabler:robot" class={icon} aria-hidden="true" />
        <span class="sr-only">工具</span>
        {shot.harness}
      </span>
    )
  }
  {
    shot.model && (
      <span class:list={['inline-flex items-center gap-1 rounded-full bg-primary/10 font-medium text-primary', pad]}>
        <Icon name="tabler:cpu" class={icon} aria-hidden="true" />
        <span class="sr-only">模型</span>
        {shot.model}
      </span>
    )
  }
  {
    shot.mode === 'vibe' ? (
      <span
        class:list={[
          'inline-flex items-center gap-1 rounded-full bg-amber-700/10 font-medium text-amber-800 dark:text-amber-300',
          pad,
        ]}
      >
        <Icon name="tabler:messages" class={icon} aria-hidden="true" />
        {vibeLabel}
      </span>
    ) : (
      <span
        class:list={[
          'inline-flex items-center gap-1 rounded-full bg-emerald-700/10 font-medium text-emerald-800 dark:text-emerald-300',
          pad,
        ]}
      >
        <Icon name="tabler:bolt" class={icon} aria-hidden="true" />
        {turns === 1 ? '一轮 · one-shot' : `one-shot · ${turns} 轮`}
      </span>
    )
  }
</div>
