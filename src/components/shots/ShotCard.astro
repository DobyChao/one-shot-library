---
import type { ImageMetadata } from 'astro';
import type { Shot } from '~/types';
import Image from '~/components/common/Image.astro';
import MetaChips from '~/components/shots/MetaChips.astro';
import { Icon } from 'astro-icon/components';
import { findImage } from '~/utils/images';
import { cleanSlug, getPermalink } from '~/utils/permalinks';
import { promptPreview } from '~/utils/utils';

export interface Props {
  shot: Shot;
  /** Zero-based position in the current list, printed as a catalog number. */
  index?: number;
}

const { shot, index } = Astro.props;
const image = await findImage(shot.image);
const link = getPermalink(shot.permalink);
const seriesHref = shot.series ? getPermalink(`/shots/series/${cleanSlug(shot.series)}`) : undefined;
const preview = shot.vibe?.trim() ? shot.vibe.trim() : promptPreview(shot.prompt, 120);
const previewLabel = shot.vibe?.trim() ? '想要的效果' : 'Prompt';

// Looping video covers recorded by `npm run screenshots -- <slug>` for entries
// with `video: true` in frontmatter. Non-image assets (webm) import as
// `{ default: string }` — the URL itself, not an ImageMetadata object.
const videoCovers = import.meta.glob<{ default: string | ImageMetadata }>('/src/assets/covers/*.webm');
const coverLoader = videoCovers[`/src/assets/covers/${shot.slug}.webm`];
const coverModule = coverLoader ? await coverLoader() : undefined;
const coverSrc = typeof coverModule?.default === 'string' ? coverModule.default : coverModule?.default?.src;

const poster = typeof image === 'string' ? image : image?.src;

const initials = shot.title
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();

const catalogNo = typeof index === 'number' ? String(index + 1).padStart(2, '0') : undefined;
---

<article
  class="group relative flex h-full w-full flex-col overflow-hidden rounded-md border border-black/10 bg-page transition duration-200 hover:border-primary/50 dark:border-white/10 dark:bg-white/[0.03]"
>
  <a href={link} class="relative block aspect-[3/2] overflow-hidden bg-black/5 dark:bg-white/5" aria-label={shot.title}>
    {
      coverSrc ? (
        <>
          {poster && (
            <img
              src={poster}
              alt=""
              data-cover-poster
              class="absolute inset-0 h-full w-full object-cover object-top transition-opacity duration-300"
            />
          )}
          <video
            src={coverSrc}
            poster={poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            data-cover-video
            class:list={[
              'relative h-full w-full object-cover object-top transition-opacity duration-300',
              poster && 'opacity-0',
            ]}
          />
        </>
      ) : image ? (
        <Image
          src={image}
          class="h-full w-full object-cover object-top transition duration-300 group-hover:scale-[1.03]"
          widths={[400, 800]}
          width={800}
          height={533}
          sizes="(max-width: 768px) 100vw, 400px"
          alt={shot.imageAlt || shot.title}
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center bg-button">
          <span class="font-mono text-5xl font-bold text-white/90">{initials}</span>
        </div>
      )
    }
    {
      catalogNo && (
        <span class="absolute left-2 top-2 bg-page/90 px-1.5 py-0.5 font-mono text-[11px] text-heading dark:bg-black/70 dark:text-white">
          {catalogNo}
        </span>
      )
    }
    {
      coverSrc && (
        <span class="absolute bottom-2 right-2 inline-flex items-center gap-1 rounded-full bg-black/65 px-2 py-0.5 text-[11px] font-medium text-white">
          <Icon name="tabler:movie" class="h-3 w-3" aria-hidden="true" />
          动态预览
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-3 p-4">
    <MetaChips shot={shot} compact />

    <h3 class="text-lg font-semibold leading-tight tracking-tight text-heading">
      <a href={link} class="transition hover:text-primary">{shot.title}</a>
    </h3>

    {shot.excerpt && <p class="line-clamp-2 text-sm text-muted">{shot.excerpt}</p>}

    <p class="border-l-2 border-button/70 pl-3 font-mono text-[12px] leading-relaxed text-default">
      <span class="mb-0.5 block text-[10px] uppercase tracking-[0.14em] text-muted">{previewLabel}</span>
      <span class="line-clamp-3">{preview}</span>
    </p>

    <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
      {
        shot.tags?.map((tag) => (
          <span class="rounded bg-black/5 px-2 py-0.5 text-xs text-muted dark:bg-white/10">{tag.title}</span>
        ))
      }
      {
        seriesHref && (
          <a
            href={seriesHref}
            class="inline-flex items-center gap-1 rounded bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary hover:underline"
          >
            <Icon name="tabler:arrows-split" class="h-3.5 w-3.5" aria-hidden="true" />
            同题对照
          </a>
        )
      }
    </div>
  </div>
</article>

<script>
  const revealCover = (video: HTMLVideoElement) => {
    video.classList.remove('opacity-0');
    video.parentElement?.querySelector('[data-cover-poster]')?.classList.add('opacity-0');
  };

  const bindCovers = () => {
    document.querySelectorAll<HTMLVideoElement>('[data-cover-video]').forEach((video) => {
      if (video.dataset.bound === '1') return;
      video.dataset.bound = '1';
      const show = () => revealCover(video);
      if (video.readyState >= 2) show();
      else {
        video.addEventListener('loadeddata', show, { once: true });
        video.addEventListener('playing', show, { once: true });
      }
    });
  };

  if (!document.documentElement.dataset.oslCovers) {
    document.documentElement.dataset.oslCovers = '1';
    document.addEventListener('astro:page-load', bindCovers);
  }
  bindCovers();
</script>
