---
import { Icon } from 'astro-icon/components';

export interface Props {
  prompt: string;
  /** Optional label above the box. */
  label?: string;
  /** Idle text on the copy button. Restored after the "已复制" flash. */
  copyLabel?: string;
  /** Anchor id, used by the detail page jump link. */
  id?: string;
}

const { prompt, label = '原始 Prompt', copyLabel = '复制 Prompt', id } = Astro.props;
const chars = prompt.trim().length;
---

<div
  data-prompt-box
  id={id}
  class="scroll-mt-24 overflow-hidden rounded-md border border-black/10 bg-black/[0.03] dark:border-white/10 dark:bg-white/[0.03]"
>
  <div
    class="flex flex-wrap items-center justify-between gap-2 border-b border-black/10 px-4 py-2.5 dark:border-white/10"
  >
    <div class="flex items-center gap-2 text-sm font-medium text-heading">
      <Icon name="tabler:message-chatbot" class="h-4 w-4 text-primary" aria-hidden="true" />
      {label}
      <span class="font-mono text-[11px] font-normal text-muted">{chars} 字</span>
    </div>
    <button
      type="button"
      data-prompt-copy
      class="inline-flex items-center gap-1.5 rounded-md bg-button px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-button-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
    >
      <Icon name="tabler:copy" class="h-3.5 w-3.5" aria-hidden="true" />
      <span data-copy-text data-copy-idle={copyLabel} aria-live="polite">{copyLabel}</span>
    </button>
  </div>
  <pre
    class="max-h-[32rem] overflow-auto whitespace-pre-wrap break-words px-4 py-4 font-mono text-sm leading-relaxed text-default"><code data-prompt-text>{prompt}</code></pre>
</div>

<script>
  // navigator.clipboard requires a focused document and a user gesture; fall
  // back to the legacy execCommand path so older/embedded browsers still copy.
  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  // Bind on `astro:page-load`: the ClientRouter swaps the DOM on in-site
  // navigation and skips identical inline scripts on revisits.
  function initPromptCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-prompt-copy]').forEach((btn) => {
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const code = btn.closest('[data-prompt-box]')?.querySelector('[data-prompt-text]');
        if (!code) return;
        const ok = await copyText(code.textContent ?? '');
        const label = btn.querySelector<HTMLElement>('[data-copy-text]');
        if (label) {
          const idle = label.dataset.copyIdle || '复制 Prompt';
          label.textContent = ok ? '已复制' : '复制失败';
          window.setTimeout(() => {
            label.textContent = idle;
          }, 2000);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initPromptCopy);
  initPromptCopy();
</script>
