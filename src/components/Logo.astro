---
import { SITE } from 'astrowind:config';
---

<span class="inline-flex items-center gap-2.5">
  <svg class="h-9 w-9 shrink-0" viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--aw-color-button)"></rect>
    <path fill="#fff" d="M12.2 8.2h3.1v15.6h-3.1z"></path>
    <path fill="#fff" d="M10.4 8.2h7.2v2.5h-7.2z"></path>
    <rect x="20.2" y="17.6" width="2.3" height="6.2" fill="#f6e7d4"></rect>
  </svg>
  <span class="flex min-w-0 flex-col leading-none">
    <span class="truncate text-sm font-semibold tracking-tight text-heading sm:text-[15px]">{SITE?.name}</span>
    <span class="mt-1 hidden font-mono text-[10px] uppercase tracking-[0.16em] text-muted sm:block"> 静态画廊 </span>
  </span>
</span>
