---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* Text / link vermilion. Dark enough for cream paper. */
    --aw-color-primary: rgb(146 42 10);
    --aw-color-secondary: rgb(68 52 42);
    --aw-color-accent: rgb(14 100 92);
    /* Filled controls. Kept dark so white labels clear WCAG AA. */
    --aw-color-button: rgb(166 48 12);
    --aw-color-button-hover: rgb(120 32 8);

    --aw-color-text-heading: rgb(28 24 20);
    --aw-color-text-default: rgb(41 36 31);
    --aw-color-text-muted: rgb(92 78 66 / 82%);
    --aw-color-bg-page: rgb(247 243 234);

    --aw-color-bg-page-dark: rgb(17 15 13);

    ::selection {
      background-color: rgb(166 48 12 / 22%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-inter);
    --aw-font-serif: var(--font-inter);
    --aw-font-heading: var(--font-inter);

    /* Lighter vermilion so links stay readable on charcoal. */
    --aw-color-primary: rgb(255 176 122);
    --aw-color-secondary: rgb(232 214 196);
    --aw-color-accent: rgb(94 234 212);
    --aw-color-button: rgb(176 56 16);
    --aw-color-button-hover: rgb(204 78 28);

    --aw-color-text-heading: rgb(247 241 230);
    --aw-color-text-default: rgb(236 228 214);
    --aw-color-text-muted: rgb(236 228 214 / 68%);
    --aw-color-bg-page: rgb(17 15 13);

    ::selection {
      background-color: rgb(255 176 122 / 32%);
      color: rgb(17 15 13);
    }
  }
</style>
